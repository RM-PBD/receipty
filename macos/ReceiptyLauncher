#!/bin/zsh

set -u

readonly executable_directory="${0:A:h}"
readonly bundle_directory="${executable_directory:h:h}"
readonly project_directory="${bundle_directory:h}"
readonly python_executable="${project_directory}/venv/bin/python"
readonly app_file="${project_directory}/app.py"
readonly log_file="${project_directory}/receipty-launcher.log"
readonly app_url="http://127.0.0.1:5001"
readonly health_url="${app_url}/api/health"
readonly expected_service_version="3"

show_error() {
    local message="$1"
    /usr/bin/osascript \
        -e 'on run argv' \
        -e 'display alert "Receipty could not start" message (item 1 of argv) as critical' \
        -e 'end run' \
        -- "$message"
}

if [[ "${1:-}" == "--serve" ]]; then
    # Run as an interactive login shell so Finder launches receive variables
    # configured in both .zprofile and .zshrc.
    exec /bin/zsh -lic 'cd "$1" && exec "$2" "$3"' \
        receipty "$project_directory" "$python_executable" "$app_file"
fi

health_response=$(/usr/bin/curl --silent --fail --max-time 1 "$health_url" 2>/dev/null || true)
if [[ "$health_response" == *'"api_key_configured":true'* \
    && "$health_response" == *"\"service_version\":\"${expected_service_version}\""* ]]; then
    /usr/bin/open "$app_url"
    exit 0
fi

if [[ ! -x "$python_executable" ]]; then
    show_error "The Python environment is missing. Keep Receipty.app inside the Receipty project folder and reinstall the project dependencies."
    exit 1
fi

if [[ ! -f "$app_file" ]]; then
    show_error "app.py was not found. Keep Receipty.app inside the Receipty project folder."
    exit 1
fi

# A launcher from an earlier Receipty version may have left an unmanaged server
# running. Stop it only after verifying both its interpreter and app path.
listener_pids=$(/usr/sbin/lsof -nP -t -iTCP:5001 -sTCP:LISTEN 2>/dev/null || true)
for listener_pid in ${(f)listener_pids}; do
    process_command=$(/bin/ps -p "$listener_pid" -o command= 2>/dev/null || true)
    if [[ "$process_command" == *"$app_file"* ]]; then
        /bin/kill "$listener_pid" 2>/dev/null || true
    fi
done

/usr/bin/nohup /bin/zsh -lic 'cd "$1" && exec "$2" "$3"' \
    receipty "$project_directory" "$python_executable" "$app_file" \
    >>"$log_file" 2>&1 </dev/null &
server_pid=$!
disown "$server_pid"

for attempt in {1..80}; do
    health_response=$(/usr/bin/curl --silent --fail --max-time 1 "$health_url" 2>/dev/null || true)
    if [[ "$health_response" == *'"api_key_configured":true'* \
        && "$health_response" == *"\"service_version\":\"${expected_service_version}\""* ]]; then
        /usr/bin/open "$app_url"
        exit 0
    fi
    if ! /bin/kill -0 "$server_pid" 2>/dev/null; then
        break
    fi
    /bin/sleep 0.25
done

show_error "Receipty did not become ready. Details were saved to receipty-launcher.log in the project folder."
exit 1
